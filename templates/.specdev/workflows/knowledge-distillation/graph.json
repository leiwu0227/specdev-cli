{
  "id": "knowledge-distillation",
  "version": "1.0.0",
  "kind": "workflow",
  "title": "Knowledge distillation",
  "description": "Distill completed assignment captures into durable project or workflow knowledge.",
  "activationHints": [
    "distill",
    "distill knowledge",
    "project knowledge",
    "workflow feedback",
    "process captures"
  ],
  "entry": "mode-choice",
  "nodes": {
    "mode-choice": {
      "purpose": "Choose which knowledge branch to distill.",
      "interaction": {
        "id": "distillation-mode",
        "kind": "choice",
        "prompt": "What should be distilled?",
        "choices": [
          { "label": "Project knowledge", "value": "project" },
          { "label": "Workflow feedback", "value": "workflow" },
          { "label": "Cancel", "value": "cancel" }
        ]
      },
      "gate": {
        "type": "external_decision",
        "decisionSchema": {
          "type": "object",
          "required": ["choice"],
          "properties": { "choice": { "enum": ["project", "workflow", "cancel"] } }
        }
      },
      "operatorContext": {
        "phase": "selection",
        "commands": {
          "project": "specdev distill project",
          "workflow": "specdev distill workflow"
        }
      },
      "edges": [
        { "to": "scan-project", "when": { "choice": "project" } },
        { "to": "scan-workflow", "when": { "choice": "workflow" } },
        { "to": "cancelled", "when": { "choice": "cancel" } }
      ]
    },
    "scan-project": {
      "purpose": "Scan unprocessed captures and existing project knowledge.",
      "instructions": "Run `specdev distill project` and submit the unprocessed assignment names and suggestions selected for consideration.",
      "outputSchema": {
        "type": "object",
        "required": ["assignments", "suggestions"],
        "properties": {
          "assignments": { "type": "array" },
          "suggestions": { "type": "array" }
        }
      },
      "operatorContext": {
        "phase": "scan",
        "mode": "project",
        "command": "specdev distill project"
      },
      "edges": [{ "to": "review-suggestions" }]
    },
    "scan-workflow": {
      "purpose": "Scan unprocessed captures and existing workflow feedback.",
      "instructions": "Run `specdev distill workflow` and submit the unprocessed assignment names and suggestions selected for consideration.",
      "outputSchema": {
        "type": "object",
        "required": ["assignments", "suggestions"],
        "properties": {
          "assignments": { "type": "array" },
          "suggestions": { "type": "array" }
        }
      },
      "operatorContext": {
        "phase": "scan",
        "mode": "workflow",
        "command": "specdev distill workflow"
      },
      "edges": [{ "to": "review-suggestions" }]
    },
    "review-suggestions": {
      "purpose": "Choose whether to write knowledge, rescan, or finish with no changes.",
      "interaction": {
        "id": "distillation-review",
        "kind": "choice",
        "prompt": "How should the distillation suggestions be handled?",
        "choices": [
          { "label": "Write selected durable knowledge", "value": "write" },
          { "label": "Rescan captures", "value": "rescan" },
          { "label": "No durable update needed", "value": "none" }
        ]
      },
      "gate": {
        "type": "external_decision",
        "decisionSchema": {
          "type": "object",
          "required": ["choice"],
          "properties": { "choice": { "enum": ["write", "rescan", "none"] } }
        }
      },
      "operatorContext": { "phase": "review" },
      "edges": [
        { "to": "write-knowledge", "when": { "choice": "write" } },
        { "to": "mode-choice", "when": { "choice": "rescan" } },
        { "to": "done", "when": { "choice": "none" } }
      ]
    },
    "write-knowledge": {
      "purpose": "Write or update the selected durable knowledge notes.",
      "instructions": "Search for existing related notes, update or create the selected knowledge, and submit written paths plus source assignment names.",
      "outputSchema": {
        "type": "object",
        "required": ["paths", "assignments", "type"],
        "properties": {
          "paths": { "type": "array" },
          "assignments": { "type": "array" },
          "type": { "enum": ["project", "workflow"] }
        }
      },
      "operatorContext": { "phase": "write" },
      "edges": [{ "to": "mark-processed" }]
    },
    "mark-processed": {
      "purpose": "Mark only the successfully distilled assignment captures as processed.",
      "instructions": "Run `specdev distill mark-processed <project|workflow> <assignment1,assignment2,...>` and submit the successful result.",
      "outputSchema": {
        "type": "object",
        "required": ["marked"],
        "properties": { "marked": { "type": "array" } }
      },
      "operatorContext": { "phase": "mark", "command": "specdev distill mark-processed" },
      "edges": [{ "to": "done" }]
    },
    "cancelled": {
      "purpose": "Knowledge distillation was cancelled.",
      "terminal": true
    },
    "done": {
      "purpose": "Knowledge distillation is complete.",
      "terminal": true
    }
  }
}
