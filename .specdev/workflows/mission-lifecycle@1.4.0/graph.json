{
  "id": "mission-lifecycle",
  "version": "1.4.0",
  "kind": "workflow",
  "title": "Mission lifecycle",
  "description": "Deliver an approved objective unattended through Assignment waves and durable gap convergence.",
  "activationHints": ["mission", "large objective", "multi assignment change"],
  "entry": "create-mission",
  "nodes": {
    "create-mission": {
      "purpose": "Create the Mission identity and contract scaffold.",
      "instructions": "Run `specdev mission create \"<objective>\"`.",
      "outputSchema": {
        "type": "object",
        "required": ["id", "path", "objective"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "objective": { "type": "string" }
        }
      },
      "operatorContext": {
        "phase": "mission",
        "command": "specdev mission create \"<objective>\""
      },
      "edges": [{ "to": "brainstorm" }]
    },
    "brainstorm": {
      "purpose": "Collaborate with the user on the Mission contract.",
      "instructions": "Finish brainstorm/contract.md. Optional review is available; after explicit agreement run `specdev mission run <id> --approve`.",
      "outputSchema": {
        "type": "object",
        "required": ["contract", "contract_hash"],
        "properties": {
          "contract": { "type": "string" },
          "contract_hash": { "type": "string" }
        }
      },
      "sideChannelActions": [
        {
          "id": "mission-brainstorm-review",
          "purpose": "Run optional Mission contract review without advancing approval."
        }
      ],
      "operatorContext": { "phase": "brainstorm", "command": "specdev mission run <id>" },
      "edges": [{ "to": "approve-mission" }]
    },
    "approve-mission": {
      "purpose": "Approve the exact Mission authority and establish its branch.",
      "sideChannelActions": [
        {
          "id": "mission-brainstorm-review",
          "purpose": "Record optional Mission contract review before approval."
        }
      ],
      "gate": {
        "type": "external_decision",
        "decisionSchema": {
          "type": "object",
          "required": [
            "approved",
            "contract_hash",
            "actor",
            "approved_at",
            "base_revision",
            "branch"
          ],
          "properties": {
            "approved": { "type": "boolean" },
            "contract_hash": { "type": "string" },
            "actor": { "type": "string" },
            "approved_at": { "type": "string" },
            "review_override": { "type": "boolean" },
            "base_revision": { "type": "string" },
            "branch": { "type": "string" }
          }
        }
      },
      "operatorContext": { "phase": "brainstorm", "command": "specdev mission run <id> --approve" },
      "edges": [
        { "to": "design", "when": { "approved": true } },
        { "to": "brainstorm", "when": { "approved": false } }
      ]
    },
    "design": {
      "purpose": "Derive one full-scope child by default, or write a justified ordered Assignment queue.",
      "instructions": "Single-child Design is deterministic; a planned split invokes the worker profile and writes design/assignments.yaml.",
      "outputSchema": {
        "type": "object",
        "required": ["queue", "attempt", "parallel"],
        "properties": {
          "queue": { "type": "string" },
          "attempt": { "type": "string" },
          "parallel": { "type": "boolean" }
        }
      },
      "operatorContext": { "phase": "design" },
      "edges": [
        { "to": "execute-wave", "when": { "parallel": true } },
        { "to": "child-assignment", "when": { "parallel": false } }
      ]
    },
    "child-assignment": {
      "purpose": "Run the next pending child through the normal Assignment lifecycle.",
      "workflowRef": { "graphId": "assignment-lifecycle" },
      "operatorContext": { "phase": "child-assignment" },
      "edges": [{ "to": "advance-queue", "when": { "approved": true } }]
    },
    "advance-queue": {
      "purpose": "Record the completed child and choose the next pending queue item.",
      "outputSchema": {
        "type": "object",
        "required": ["remaining", "completed", "follow_up_required", "gap_open", "parallel"],
        "properties": {
          "remaining": { "type": "boolean" },
          "completed": { "type": "string" },
          "follow_up_required": { "type": "boolean" },
          "gap_open": { "type": "boolean" },
          "gap_id": { "type": "string" },
          "parallel": { "type": "boolean" }
        }
      },
      "operatorContext": { "phase": "mission" },
      "edges": [
        { "to": "resolve-gap", "when": { "gap_open": true } },
        {
          "to": "execute-wave",
          "when": { "remaining": true, "parallel": true }
        },
        {
          "to": "child-assignment",
          "when": { "remaining": true, "parallel": false }
        },
        { "to": "mission-review", "when": { "remaining": false } }
      ]
    },
    "execute-wave": {
      "purpose": "Run the current independent Assignment wave in bounded isolated worktrees.",
      "instructions": "The foreground Mission controller launches up to three child Assignment runs, creates reviewed delivery commits, and integrates them in declared order.",
      "outputSchema": {
        "type": "object",
        "required": ["wave", "completed"],
        "properties": {
          "wave": { "type": "number" },
          "completed": { "type": "array", "items": { "type": "string" } }
        }
      },
      "operatorContext": { "phase": "parallel-wave" },
      "edges": [{ "to": "advance-wave" }]
    },
    "advance-wave": {
      "purpose": "Record the integrated wave and select the next sequential or parallel stage.",
      "outputSchema": {
        "type": "object",
        "required": ["remaining", "completed", "follow_up_required", "gap_open", "parallel"],
        "properties": {
          "remaining": { "type": "boolean" },
          "completed": { "type": "string" },
          "follow_up_required": { "type": "boolean" },
          "gap_open": { "type": "boolean" },
          "gap_id": { "type": "string" },
          "parallel": { "type": "boolean" }
        }
      },
      "operatorContext": { "phase": "mission" },
      "edges": [
        { "to": "resolve-gap", "when": { "gap_open": true } },
        {
          "to": "execute-wave",
          "when": { "remaining": true, "parallel": true }
        },
        {
          "to": "child-assignment",
          "when": { "remaining": true, "parallel": false }
        },
        { "to": "mission-review", "when": { "remaining": false } }
      ]
    },
    "mission-review": {
      "purpose": "Reuse exact full-scope child review evidence or review Mission convergence when scopes differ.",
      "outputSchema": {
        "type": "object",
        "required": ["approved", "verdict", "attempt", "disposition"],
        "properties": {
          "approved": { "type": "boolean" },
          "verdict": { "type": "string" },
          "attempt": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["approved", "nonblocking-override", "repair", "semantic-failure"]
          }
        }
      },
      "operatorContext": { "phase": "mission-review" },
      "edges": [
        { "to": "final-verification", "when": { "approved": true } },
        { "to": "resolve-gap", "when": { "approved": false, "disposition": "repair" } },
        {
          "to": "failed",
          "when": { "approved": false, "disposition": "semantic-failure" }
        }
      ]
    },
    "resolve-gap": {
      "purpose": "Converge one durable Mission gap through resolution, resolver, and arbiter stages.",
      "outputSchema": {
        "type": "object",
        "required": [
          "queue",
          "reason",
          "gap_id",
          "stage",
          "attempt",
          "disposition",
          "gap_open",
          "remaining",
          "parallel"
        ],
        "properties": {
          "queue": { "type": "string" },
          "reason": { "type": "string" },
          "gap_id": { "type": "string" },
          "stage": {
            "type": "string",
            "enum": ["resolution", "resolver", "arbiter"]
          },
          "attempt": { "type": "string" },
          "gap_open": { "type": "boolean" },
          "remaining": { "type": "boolean" },
          "parallel": { "type": "boolean" },
          "disposition": {
            "type": "string",
            "enum": [
              "resolution-added",
              "evidence-closed",
              "semantic-failure",
              "authority-failure",
              "infrastructure-failure"
            ]
          }
        }
      },
      "operatorContext": { "phase": "gap-resolution" },
      "edges": [
        { "to": "child-assignment", "when": { "disposition": "resolution-added" } },
        {
          "to": "resolve-gap",
          "when": { "disposition": "evidence-closed", "gap_open": true }
        },
        {
          "to": "execute-wave",
          "when": {
            "disposition": "evidence-closed",
            "gap_open": false,
            "remaining": true,
            "parallel": true
          }
        },
        {
          "to": "child-assignment",
          "when": {
            "disposition": "evidence-closed",
            "gap_open": false,
            "remaining": true,
            "parallel": false
          }
        },
        {
          "to": "mission-review",
          "when": {
            "disposition": "evidence-closed",
            "gap_open": false,
            "remaining": false
          }
        },
        { "to": "failed", "when": { "disposition": "semantic-failure" } },
        { "to": "failed", "when": { "disposition": "authority-failure" } },
        { "to": "failed", "when": { "disposition": "infrastructure-failure" } }
      ]
    },
    "final-verification": {
      "purpose": "Run the one exact integrated verification authorized by the Mission contract.",
      "outputSchema": {
        "type": "object",
        "required": ["passed", "receipt", "recoverable"],
        "properties": {
          "passed": { "type": "boolean" },
          "receipt": { "type": "string" },
          "recoverable": { "type": "boolean" }
        }
      },
      "operatorContext": { "phase": "verification" },
      "edges": [
        { "to": "done", "when": { "passed": true } },
        { "to": "resolve-gap", "when": { "passed": false, "recoverable": true } }
      ]
    },
    "done": {
      "purpose": "Mission lifecycle is complete on its Mission branch.",
      "terminal": true
    },
    "failed": {
      "purpose": "Mission delivery ended with a semantic, authority, or infrastructure terminal failure.",
      "terminal": true
    }
  }
}
